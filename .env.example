# ─── Where the backend lives ─────────────────────────────────────────────────
# REST base, including the /api/v1 prefix. Must match the backend's API_PREFIX.
NEXT_PUBLIC_API_URL=http://localhost:5010/api/v1

# Socket.IO origin — the bare host, with NO /api/v1 on the end.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5010

# ─── Menu photos ─────────────────────────────────────────────────────────────
# Comma-separated list of origins next/image is allowed to optimise from.
# Dev (backend STORAGE_DRIVER=local):  http://localhost:5010
# Production (STORAGE_DRIVER=bunny):   your BUNNY_CDN_URL pull-zone host
# List both if you switch between them without rebuilding.
NEXT_PUBLIC_IMAGE_ORIGINS=http://localhost:5010

# ─── Reminders for the backend side ──────────────────────────────────────────
# The backend must allow this app's origin:
#   CORS_ORIGINS=http://localhost:3000
# and print QR codes that point back here:
#   CUSTOMER_BASE_URL=http://localhost:3000
# A table's QR resolves to <CUSTOMER_BASE_URL>/order/<tableCode>.

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION VALUES (tapriwala.acdwithsameer.com)
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* values are compiled into the browser bundle at BUILD time, not
# read at boot. Changing one on the VPS means running `npm run build` again —
# restarting the process alone does nothing. Treat them as public: never put a
# secret behind a NEXT_PUBLIC_ name.
#
#   NEXT_PUBLIC_API_URL=https://tapriwala-api.acdwithsameer.com/api/v1
#   NEXT_PUBLIC_SOCKET_URL=https://tapriwala-api.acdwithsameer.com
#   NEXT_PUBLIC_IMAGE_ORIGINS=https://<your-zone>.b-cdn.net
#
# And on the backend:
#   CORS_ORIGINS=https://tapriwala.acdwithsameer.com
#   CUSTOMER_BASE_URL=https://tapriwala.acdwithsameer.com

# ─── Printed receipt (80mm thermal) ──────────────────────────────────────────
# Header and footer of the receipt printed from the billing screen.
#
# NEXT_PUBLIC_SHOP_GSTIN is the switch that decides what this paper IS. Set it
# and the header prints the GSTIN and the receipt calls itself a TAX INVOICE.
# Leave it empty and it stays a plain customer copy with no tax claim on it.
#
# Set it only while this portal issues the ONLY bill for a sale. If the café's
# old billing software is ever put back in front of the same payment, empty this
# again — two invoice numbers against one payment is a filing problem.
#
# Keep the name and address to ~30 characters per line: the receipt is 32
# monospace columns wide and anything longer is cut, not wrapped.
#
# These are NEXT_PUBLIC_*, so they are inlined at BUILD time. Changing one and
# running `pm2 restart` does nothing — you must `npm run build` again.
NEXT_PUBLIC_SHOP_NAME=TAPRIWALA BY TREATMEETS
NEXT_PUBLIC_SHOP_ADDRESS_1=
NEXT_PUBLIC_SHOP_ADDRESS_2=
NEXT_PUBLIC_SHOP_PHONE=
NEXT_PUBLIC_SHOP_GSTIN=
NEXT_PUBLIC_SHOP_FOOTER=THANK YOU ! VISIT AGAIN
